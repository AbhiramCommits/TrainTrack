{
  "name": "traintrack-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5273",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
