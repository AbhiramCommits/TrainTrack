# ---- Database (host port 55432 avoids clashing with other local Postgres instances) ----
POSTGRES_USER=traintrack
POSTGRES_PASSWORD=traintrack
POSTGRES_DB=traintrack
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://traintrack:traintrack@localhost:55432/traintrack

# ---- Redis ----
REDIS_URL=redis://localhost:56379/0
REDIS_LOG_MAXLEN=10000

# ---- RabbitMQ ----
RABBITMQ_USER=traintrack
RABBITMQ_PASSWORD=traintrack
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
AMQP_URL=amqp://traintrack:traintrack@localhost:5672/%2F
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# ---- API ----
TRAINTRACK_API_HOST=0.0.0.0
TRAINTRACK_API_PORT=8010
TRAINTRACK_API_URL=http://localhost:8010
TRAINTRACK_SECRET_KEY=change-me-in-production
TRAINTRACK_DEV_API_KEY=tt_dev_local_key_do_not_use_in_prod
TRAINTRACK_RATE_LIMIT=120

# ---- Workers / executors ----
TRAINTRACK_EXECUTOR=local          # local | kubernetes
TRAINTRACK_MAX_ATTEMPTS=3
TRAINTRACK_WORKER_PREFETCH=1
TRAINTRACK_JOB_TIMEOUT=3600
TRAINTRACK_K8S_NAMESPACE=traintrack
TRAINTRACK_K8S_IMAGE=traintrack:dev
TRAINTRACK_K8S_CPU_REQUEST=1
TRAINTRACK_K8S_CPU_LIMIT=4
TRAINTRACK_K8S_MEMORY_REQUEST=1Gi
TRAINTRACK_K8S_MEMORY_LIMIT=6Gi
TRAINTRACK_K8S_GPU_NODE_SELECTOR_KEY=runpod.io/gpu
KUBECONFIG=~/.kube/config

# ---- Storage ----
TRAINTRACK_ARTIFACT_ROOT=./artifacts
TRAINTRACK_DATA_ROOT=./data
TRAINTRACK_SNAPSHOT_DIR=https://ossci-datasets.s3.amazonaws.com/mnist

# ---- Frontend ----
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:8010

# ---- Observability ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=traintrack
