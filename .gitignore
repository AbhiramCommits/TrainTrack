# Data and artifacts (content is reproducible; manifests are committed via results)
data/raw/
data/snapshots/
# Anchored to the repo root: an unanchored "artifacts/" also matched the
# traintrack/artifacts/ Python package, so it was never committed.
/artifacts/*
!/artifacts/.gitkeep
*.pt
*.pth
checkpoints/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/

# Logs / OS
*.log
.DS_Store
server.pid
.pids/

# Kubernetes
deploy/k8s/generated/
